<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head.ejs') %>
</head>
<body>
    <%- include('../fragmente/header.ejs') %>

    <main class="grid-layout" style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 50px;">
        <section id="zona1" style="width: 100%; max-width: 800px; padding: 40px; border: 2px solid var(--clr-main);">
            <h2><%= locals.titlu %></h2>
            <p style="font-size: 1.2rem; margin: 20px 0;"><%= locals.text %></p>
            
            <% if (locals.imagine) { %>
                <figure>
                    <img src="<%= locals.imagine %>" alt="Imagine eroare" style="max-width: 300px; border-radius: 10px; margin-top: 20px;">
                </figure>
            <% } %>

            <a href="/" style="display: inline-block; margin-top: 30px; padding: 10px 20px; background-color: var(--clr-dark-blue); color: var(--clr-white); border-radius: 5px; text-decoration: none;">Înapoi la pagina principală</a>
        </section>
    </main>

    <%- include('../fragmente/footer.ejs') %>
</body>
</html>